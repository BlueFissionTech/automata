{
    "name": "bluefission/automata",
    "type": "library",
    "description": "Machine learning / communication systems",
    "homepage": "https://github.com/BlueFissionTech/automata",
    "license": "MIT",
    "keywords": [
        "automata",
        "ai",
        "nlp",
        "machine learning",
        "chatbot",
        "bot",
        "communication",
        "natural language processing"
    ],
    "authors": [
        {
            "name": "Devon Scott",
            "email": "dscott@bluefission.com",
            "homepage": "https://bluefission.com",
            "role": "Developer"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/BlueFissionTech/chronicler.git"
        },
        {
            "type": "package",
            "package": {
                "name": "bluefission/simpleclients",
                "version": "dev-master",
                "source": {
                    "type": "git",
                    "url": "https://github.com/BlueFissionTech/simpleclients.git",
                    "reference": "858ea3575b5eb725879c0066d152e07538019392"
                },
                "require": {
                    "bluefission/develation": "^1.0.0-alpha",
                    "simplehtmldom/simplehtmldom": "^2.0@RC"
                },
                "autoload": {
                    "psr-4": {
                        "BlueFission\\": "src/"
                    },
                    "classmap": [
                        "src/"
                    ]
                }
            }
        }
    ],
    "minimum-stability": "dev",
    "require": {
        "php": ">=8.2",
        "bluefission/develation": "^1.3.39",
        "bluefission/chronicler": "^0.1.2-alpha",
        "bluefission/simpleclients": "dev-master",
        "google-gemini-php/client": "dev-main",
        "orhanerday/open-ai": "^2.2",
        "php-ai/php-ml": "^0.10.0",
        "symfony/http-client": "^7.4@dev",
        "nyholm/psr7": "^1.8@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "suggest": {
        "ext-ds": "Improves performance for collection types (Deque, Map, Set, Stack, PriorityQueue, Vector). Optional; Automata falls back when absent."
    },
    "autoload": {
        "psr-4": {
            "BlueFission\\": "src/"
        },
        "classmap": [
           "src/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "BlueFission\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit --do-not-cache-result"
    },
    "config": {
        "platform-check": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "archive": {
        "exclude": [
            "/.agents",
            "/.codex",
            "/.github",
            "/.phpunit.cache",
            "/.phpunit.result.cache",
            "/AGENTS.behavior.md",
            "/AGENTS.md",
            "/ARCHITECTURE.md",
            "/SPEC.md",
            "/artifacts",
            "/composer.lock",
            "/docker",
            "/examples",
            "/harness.json",
            "/phpunit.xml",
            "/scripts",
            "/templates",
            "/tests"
        ]
    },
    "support": {
        "issues": "https://github.com/BlueFissionTech/automata/issues",
        "source": "https://github.com/BlueFissionTech/automata"
    }
}
