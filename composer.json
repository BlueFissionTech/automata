{
    "name": "bluefission/automata",
    "description": "Machine learning / communication systems",
    "license": "MIT",
    "keywords": [
        "automata",
        "ai",
        "nlp",
        "machine learning",
        "chatbot",
        "bot",
        "communication",
        "natural language processing"
    ],
    "authors": [
        {
            "name": "Devon Scott",
            "email": "dscott@bluefission.com",
            "homepage": "https://bluefission.com",
            "role": "Developer"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/bluefissiontech/develation"
        },
        {
            "type": "vcs",
            "url": "https://github.com/BlueFissionTech/simpleclients"
        }
    ],
    "minimum-stability": "dev",
    "require": {
        "php": ">=8.2",
        "bluefission/develation": "^1.2.0-alpha",
        "bluefission/simpleclients": "dev-master",
        "google-gemini-php/client": "dev-main",
        "orhanerday/open-ai": "^2.2",
        "php-ai/php-ml": "^0.10.0",
        "symfony/http-client": "^7.4@dev",
        "nyholm/psr7": "^1.8@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "suggest": {
        "ext-ds": "Improves performance for collection types (Deque, Map, Set, Stack, PriorityQueue, Vector). Optional; Automata falls back when absent."
    },
    "autoload": {
        "psr-4": {
            "BlueFission\\": "src/"
        },
        "classmap": [
           "src/"
        ]
    },
    "autoload-dev": {
        "psr-4": { 
            "BlueFission\\Tests\\": "tests/" 
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
