{
    "name": "bluefission/automata",
    "type": "library",
    "description": "Machine learning / communication systems",
    "homepage": "https://github.com/BlueFissionTech/automata",
    "license": "MIT",
    "keywords": [
        "automata",
        "ai",
        "nlp",
        "machine learning",
        "chatbot",
        "bot",
        "communication",
        "natural language processing"
    ],
    "authors": [
        {
            "name": "Devon Scott",
            "email": "dscott@bluefission.com",
            "homepage": "https://bluefission.com",
            "role": "Developer"
        }
    ],
    "minimum-stability": "dev",
    "require": {
        "php": ">=8.2",
        "bluefission/develation": "^1.3.39",
        "bluefission/chronicler": "^0.1.2-alpha",
        "php-ai/php-ml": "^0.10.0"
    },
    "require-dev": {
        "bluefission/simpleclients": "^0.1.0-alpha",
        "phpunit/phpunit": "^11.5"
    },
    "suggest": {
        "bluefission/simpleclients": "Install for optional provider-backed OCR, transcription, video analysis, Claude, Gemini, Grok, and related client adapters.",
        "ext-ds": "Improves performance for collection types (Deque, Map, Set, Stack, PriorityQueue, Vector). Optional; Automata falls back when absent.",
        "google-gemini-php/client": "Install when using SimpleClients Gemini adapters without injecting a custom Gemini-compatible client.",
        "nyholm/psr7": "Install when using PSR-7 based provider transports that require a concrete PSR-7 implementation.",
        "orhanerday/open-ai": "Install for applications that prefer the orhanerday OpenAI client over Automata's built-in Curl connector.",
        "symfony/http-client": "Install when using provider transports that require Symfony's HTTP client implementation."
    },
    "autoload": {
        "psr-4": {
            "BlueFission\\": "src/"
        },
        "classmap": [
           "src/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "BlueFission\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit --do-not-cache-result"
    },
    "config": {
        "platform-check": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "archive": {
        "exclude": [
            "/.agents",
            "/.codex",
            "/.github",
            "/.phpunit.cache",
            "/.phpunit.result.cache",
            "/AGENTS.behavior.md",
            "/AGENTS.md",
            "/ARCHITECTURE.md",
            "/SPEC.md",
            "/artifacts",
            "/composer.lock",
            "/docker",
            "/examples",
            "/harness.json",
            "/phpunit.xml",
            "/scripts",
            "/templates",
            "/tests"
        ]
    },
    "support": {
        "issues": "https://github.com/BlueFissionTech/automata/issues",
        "source": "https://github.com/BlueFissionTech/automata"
    }
}
